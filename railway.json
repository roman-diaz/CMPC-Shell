{
  "name": "OKR-Shell",
  "builder": "nixpacks",
  "buildCommand": "npm run build",
  "startCommand": "npm start",
  "variables": {
    "USABILITY_METRICS_MF_URI": "${{ UsabilityMetrics-MF.RAILWAY_PUBLIC_DOMAIN }}",
    "MF_CONTAINERS_URI": "${{ UsabilityMetrics-MF.RAILWAY_PUBLIC_DOMAIN }}",
    "VITE_BYPASS_AUTH": "true",
    "VITE_AZURE_CLIENT_ID": "00000000-0000-0000-0000-000000000000",
    "VITE_AZURE_TENANT_ID": "00000000-0000-0000-0000-000000000000",
    "VITE_AZURE_REDIRECT_URI": "https://cmpc-shell-production.up.railway.app"
  },
  "ports": [
    {
      "port": 5003
    }
  ]
}
